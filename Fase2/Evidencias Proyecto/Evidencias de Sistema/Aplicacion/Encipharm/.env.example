# Copiar a .env (esta en .gitignore) y completar. Sin las variables
# OBLIGATORIAS, `docker compose up` se detiene con un mensaje de error.
#
# Generar un secreto aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# --- OBLIGATORIAS ---------------------------------------------------------
# Firma de JWT de Enci-Ventas y de Enci-Intel (valores distintos entre si).
JWT_SECRET=
JWT_SECRET_KEY=
# Clave compartida servicio-a-servicio: Enci-Ventas la envia como X-API-Key
# y Enci-Intel la valida. Es la misma para ambos lados.
INTEL_SERVICE_API_KEY=

# --- OPCIONALES: bases de datos online (si se omiten, se usan las locales) -
# Enci-Ventas -> Cloud Firestore (mismo proyecto que Intel; sus colecciones llevan prefijo "ventas_").
# Local: emulador (por defecto). Nube: proyecto real, emulador vacio y la credencial en UNA linea.
#VENTAS_FIREBASE_PROJECT_ID=tu-proyecto-firebase
#VENTAS_FIRESTORE_EMULATOR_HOST=
#VENTAS_FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# Enci-Intel -> Cloud Firestore
#FIREBASE_PROJECT_ID=tu-proyecto-firebase   (Enci-Intel; con credencial real: FIREBASE_CREDENTIALS_PATH y sin FIRESTORE_EMULATOR_HOST)

# --- OPCIONALES: RAG / IA -------------------------------------------------
# Por defecto apunta a DeepSeek directo (deepseek-chat, api.deepseek.com).
# Tambien acepta cualquier proveedor OpenAI-compatible, ej. NVIDIA NIM
# (https://build.nvidia.com, gratis, key con prefijo nvapi-). Ojo: en el tier
# gratis de NVIDIA los modelos mas pedidos (deepseek-v4.1-flash, glm-5.3) se
# cuelgan sin responder por saturacion; meta/llama-3.2-11b-vision-instruct
# si respondio de forma confiable en las pruebas (ver README).
#DEEPSEEK_API_KEY=
#DEEPSEEK_BASE_URL=https://integrate.api.nvidia.com/v1
#DEEPSEEK_MODEL=meta/llama-3.2-11b-vision-instruct

# --- OPCIONALES: chat de competencia (Enci-Ventas, RQ-08) -----------------
# Usa el mismo proveedor que arriba (DEEPSEEK_*). Sin DEEPSEEK_API_KEY el chat
# responde 503 con un mensaje claro y no gasta la cuota del usuario.
# Modelo propio para este chat (por defecto usa DEEPSEEK_MODEL). Necesita un
# modelo que soporte llamadas a funciones (function calling).
#COMPETENCIA_MODEL=
# Tope de preguntas por usuario y dia.
#COMPETENCIA_CHAT_DAILY_LIMIT=50
# Costo aproximado por 1000 tokens (USD) para el reporte mensual de uso.
#COMPETENCIA_PRICE_PER_1K_INPUT=0
#COMPETENCIA_PRICE_PER_1K_OUTPUT=0
# Busqueda web en vivo (Tavily). Apagada por defecto: tiene costo variable y el
# contenido de internet no es confiable.
#WEB_SEARCH_ENABLED=false
#TAVILY_API_KEY=

# --- OPCIONALES: invitaciones de usuarios (Enci-Ventas, RQ-05) ------------
# URL publica de la web de Ventas: se usa para armar el enlace de invitacion.
#FRONTEND_URL=http://localhost:5173
# Horas de vigencia del enlace de invitacion o restablecimiento.
#INVITATION_TTL_HOURS=72
