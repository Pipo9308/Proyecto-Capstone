GEMINI_API_KEY=your_gemini_api_key_here
CHAT_AUTH_REQUIRED=true
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Bucket GCS para persistir el vector store y los PDFs en Cloud Run.
# Si no se define, se usa el disco local (desarrollo).
# GCS_BUCKET_NAME=enci-intel-rag

# --- FALLBACK GROQ (sin cuota de embeddings, ideal para desarrollo local) ---
# Groq tiene prioridad sobre Gemini si GROQ_API_KEY está activo.
# Al cambiar de proveedor, elimina Backend/data/vector_store.pkl y reinicia.
# GROQ_API_KEY=your_groq_api_key_here

JWT_SECRET_KEY=change_this_to_a_secure_random_key

# Clave compartida para llamadas servicio-a-servicio (el proxy de Enci-Ventas
# la envia como header X-API-Key). Debe coincidir con ENCI_INTEL_API_KEY en
# Enci-Ventas/Backend/.env. Sin esto, los endpoints de lectura consumidos por
# el proxy (market, chat) solo aceptan JWT de usuario.
INTEL_SERVICE_API_KEY=change_this_shared_service_key

# Cloud Firestore. Local: emulador (FIRESTORE_EMULATOR_HOST) y cualquier id de proyecto.
# Nube: id del proyecto de Firebase y la ruta del JSON de la cuenta de servicio (fuera de git).
FIREBASE_PROJECT_ID=enci-local
FIRESTORE_EMULATOR_HOST=localhost:8085
#FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
# El RAG usa Firestore Vector Search (coleccion RAG_COLLECTION, por defecto intel_docs). Crear el indice: scripts/create_vector_index.py
REDIS_URL=redis://localhost:6379/0
DEEPSEEK_API_KEY=your_deepseek_api_key
