APP_NAME="Enci Ventas API"
APP_ENV=development
APP_VERSION=1.0.0
ENABLE_TEMPORARY_ROLE_SWITCHER=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://localhost:5175","http://127.0.0.1:5173","http://127.0.0.1:5174","http://127.0.0.1:5175"]
# Optional regex for preview deployments. Keep empty unless needed.
CORS_ORIGIN_REGEX=

# Cloud Firestore (unica base de datos). Local: emulador y cualquier id de proyecto.
# Nube: id del proyecto real y FIREBASE_CREDENTIALS_JSON (el JSON de la cuenta de servicio en UNA linea).
FIREBASE_PROJECT_ID=enci-local
FIRESTORE_EMULATOR_HOST=localhost:8085
#FIREBASE_CREDENTIALS_JSON=
JWT_SECRET=

# RAG assistant
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
GCS_BUCKET_DOCUMENTS=encipharm-rag-documents
# Fallback usado cuando APP_ENV no es production y GCS_BUCKET_DOCUMENTS esta vacio.
LOCAL_DOCUMENT_STORAGE_DIR=./document_storage
MAX_TOKENS_RESPONSE=1024
MAX_CONTEXT_CHUNKS=5
SIMILARITY_THRESHOLD=0.30
RAG_CHAT_RATE_LIMIT_PER_MINUTE=30
RAG_MAX_UPLOAD_BYTES=20971520

# UAT/go-live checks
# GET /readiness debe responder status=ready antes de abrir UAT o produccion.

# Enci Inteligencia
ENCI_INTEL_API_URL=https://api.inteligencia.encipharm.com
ENCI_INTEL_API_KEY=your_enci_intel_api_key_here

# Redis
REDIS_URL=redis://redis:6379/0
